# Postgres
POSTGRES_USER=fleet
POSTGRES_PASSWORD=fleet
POSTGRES_DB=fleet
POSTGRES_PORT=5432

# Ports publiés sur l'hôte
NESTJS_PORT=3000
MCP_PORT=3100
WEB_PORT=4200
SIM_PORT=3200

# NESTJS
DATABASE_URL=postgres://fleet:fleet@postgres:5432/fleet
# Détecteur et décision (spec 03)
FUEL_DROP_MIN_L=40
DETECTOR_DEBOUNCE_SECONDS=15
AUTO_CLOSE_MIN_CONFIDENCE=0.75
TASK_SWEEP_INTERVAL_MS=30000

# Jetons de développement (spec 08)
DEVICE_TOKEN=dev-device-token
AGENT_API_TOKEN=dev-agent-token
ADMIN_TOKEN=dev-admin-token
MCP_CLIENT_TOKEN=dev-mcp-token

# URLs internes au réseau Docker
API_URL=http://nestjs:3000
MCP_URL=http://mcp-server:3100/mcp

# Modèle (Ollama sur l'hôte)
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=fleet-qwen

# Agents
POLL_INTERVAL_MS=2000
MAX_TOOL_CALLS=10

# Simulateur (spec 04) : graine, vitesse initiale (30, 60, 120, 300 ou 600), heure de début du rejeu
SIM_SEED=42
SIM_SPEED=120
SIM_FROM=02:00
