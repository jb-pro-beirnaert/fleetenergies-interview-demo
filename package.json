{
  "name": "fleetenergies-interview-demo",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "docker compose -f docker-compose.dev.yaml up --build",
    "dev:up": "docker compose -f docker-compose.dev.yaml up -d --build",
    "dev:down": "docker compose -f docker-compose.dev.yaml down",
    "dev:logs": "docker compose -f docker-compose.dev.yaml logs -f nestjs",
    "dev:rebuild": "docker compose -f docker-compose.dev.yaml up -d --build -V",
    "dev:db:reset": "docker compose -f docker-compose.dev.yaml down -v && docker compose -f docker-compose.dev.yaml up -d --build",
    "dev:db:studio": "set -a && . ./.env && set +a && npm run prisma:studio -w apps/nestjs -- --url \"postgres://$POSTGRES_USER:$POSTGRES_PASSWORD@localhost:$POSTGRES_PORT/$POSTGRES_DB\"",
    "prod:up": "docker compose -f docker-compose.yaml up -d --build",
    "prod:down": "docker compose -f docker-compose.yaml down",
    "prod:logs": "docker compose -f docker-compose.yaml logs -f nestjs",
    "test": "npm test --workspaces --if-present",
    "test:e2e": "npm run test:e2e -w apps/nestjs",
    "test:db:up": "docker compose -f docker-compose.test.yaml up -d --wait",
    "test:db:down": "docker compose -f docker-compose.test.yaml down",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "description": "",
  "repository": {
    "type": "git",
    "url": "github-jb-pro-beirnaert:jb-pro-beirnaert/fleetenergies-interview-demo.git"
  }
}
